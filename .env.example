# Fuso horario do backend: define a janela de envio e o reset do cap diario.
TZ=America/Sao_Paulo

# Evolution API — provedor alternativo de WhatsApp, na propria VPS. Uma
# instancia escolhe o provedor pelo campo `provider` no seu config; sem isso
# ela continua na UazAPI.
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
# Rede docker onde o container do Evolution vive (docker network ls)
EVOLUTION_NETWORK=evolution_evo-internal

# Postgres local (container sender-db). A senha nao tem default: sem ela o
# compose se recusa a subir, em vez de nascer com credencial conhecida.
SENDER_DB_USER=sender
SENDER_DB_PASSWORD=
SENDER_DB_NAME=whatsapp_sender

# Database (Supabase)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Redis (Upstash TLS)
REDIS_URL="rediss://default:[password]@[endpoint].upstash.io:6379"

# UazAPI
# Host da UazAPI. NAO e a porta 8080 da VPS — la roda a Evolution API,
# que responde 401/404 e faz parecer token invalido.
UAZAPI_URL="https://SEU-HOST.uazapi.com"
UAZAPI_GLOBAL_TOKEN="your-uazapi-token"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# Backend
PORT=3001
# Allow-list de CORS, separada por virgula. Precisa conter TODO dominio que
# abre o painel, inclusive o da Vercel — senao toda chamada vira 500.
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Porta publicada do backend no host (a VPS usa 3003, atras do nginx).
API_PORT=3001
